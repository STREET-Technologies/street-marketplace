# Optional explicit origin for a deployed staging site. Local development derives it from the request.
# MARKETPLACE_ORIGIN=https://marketplace-staging.street.london
# STREET API is intentionally fixed to staging in lib/server/config.ts.

# Server-only Mapbox token for device-location postcode labels (also set in Vercel).
# MAPBOX_ACCESS_TOKEN=

# Google Identity Services Web client from the existing STREET staging project.
# Public client ID; read by the server and returned only when configured.
# Register each exact marketplace origin with Google. No client secret is needed.
# GOOGLE_CLIENT_ID=

# Web checkout remains disabled until the shared backend is deployed and activation is approved.
# Only the allowlisted Gymshark staging outlet is supported. Never NEXT_PUBLIC_.
CHECKOUT_ENABLED=false
